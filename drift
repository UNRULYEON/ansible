#!/usr/bin/env python3
"""Compare the apps on this Mac with the apps in the playbook."""

import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).parent


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def yaml_list(path, key):
    """Return the items of a top-level list in a simple YAML file."""
    text = (ROOT / path).read_text()
    block = re.search(rf"^{key}:\n((?:\s+- .*\n?)+)", text, re.M)
    return {line.split("- ", 1)[1].split("#")[0].strip() for line in block[1].splitlines()}


def mas_ids(text):
    return {int(m[1]): m[2].strip() for m in re.finditer(r"^\s*(\d+)\s+(.+?)\s+\(", text, re.M)}


def report(title, on_mac, in_playbook, installed=None):
    missing = sorted(on_mac - in_playbook, key=str.lower)
    extra = sorted(in_playbook - (installed or on_mac), key=str.lower)
    print(f"\n== {title}")
    print("  On this Mac, not in playbook:", ", ".join(missing) or "none")
    print("  In playbook, not on this Mac:", ", ".join(extra) or "none")


brew_vars = "roles/homebrew/vars/main.yml"
report(
    "Homebrew formulae",
    set(run("brew", "leaves", "--installed-on-request").split()),
    yaml_list(brew_vars, "homebrew_installed_packages"),
    # Also count dependencies, e.g. pyenv comes with pyenv-virtualenv.
    set(run("brew", "list", "--formula").split()),
)
report(
    "Homebrew casks",
    set(run("brew", "list", "--cask").split()),
    yaml_list(brew_vars, "homebrew_cask_apps"),
)

installed = mas_ids(run("mas", "list"))
mas_tasks = (ROOT / "roles/mas/tasks/main.yml").read_text()
wanted = {int(m[1]): m[2].strip() for m in re.finditer(r"- (\d+) # (.+)", mas_tasks.split("Uninstall")[0])}
report(
    "App Store",
    {f"{name} ({i})" for i, name in installed.items()},
    {f"{installed.get(i, name)} ({i})" for i, name in wanted.items()},
)
