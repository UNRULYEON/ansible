#!/usr/bin/env bash
set -euo pipefail

cd ~

# The Homebrew installer also installs the Xcode Command Line Tools.
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
eval "$(/opt/homebrew/bin/brew shellenv)"

brew install ansible

rm -rf ansible
git clone --branch "${BRANCH:-main}" https://github.com/UNRULYEON/ansible.git
cd ansible

ansible-galaxy install -r requirements.yml --force
ansible-playbook main.yml --ask-become-pass

cd ..
rm -rf ansible

echo "➜ Rebooting in 60 seconds so all settings apply. Press Enter to reboot now, or Ctrl+C to cancel."
read -r -t 60 </dev/tty || true
sudo shutdown -r now
